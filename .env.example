# Copier ce fichier en .env et le compléter. Ne jamais commiter .env.

# Port et adresse d'écoute du serveur.
# 127.0.0.1 : accessible seulement depuis cette machine (par défaut).
# 0.0.0.0 : accessible depuis l'extérieur, à utiliser chez un hébergeur.
PORT=8787
HOST=127.0.0.1

# Hôtes publics acceptés par le serveur, séparés par des virgules (ex. seo.exemple.fr).
# Vide : seuls localhost et 127.0.0.1 sont acceptés. À renseigner chez un hébergeur.
ALLOWED_HOSTS=

# Dossier de la base de données
DATA_DIR=./data

# Clé de l'API Claude, pour l'assistant IA (https://console.anthropic.com).
# Sans elle, l'assistant est désactivé ; le reste fonctionne.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clé Firecrawl, pour le relevé des concurrents sur Google.
# Sans elle, la section Concurrents est désactivée ; le reste fonctionne.
FIRECRAWL_API_KEY=

# Connexion à la boutique Shopify (application personnalisée, Client Credentials Grant).
# Domaine au format ma-boutique.myshopify.com. Le jeton (24 h) est demandé et renouvelé
# automatiquement par le serveur ; il n'est jamais écrit sur disque.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Mode de l'application Shopify. Vide ou "local" : développement, connexion « Client Credentials ».
# "embedded" : application publique affichée dans l'administration Shopify (jeton de session exigé sur
# toutes les requêtes). Dans ce mode, SHOPIFY_CLIENT_ID et SHOPIFY_CLIENT_SECRET sont obligatoires et sont
# ceux de l'application publique ; SHOPIFY_STORE_DOMAIN est ignorée (toute boutique installée est servie).
SHOPIFY_APP_MODE=

# Clé de chiffrement des jetons des boutiques (mode "embedded" seulement, obligatoire dans ce mode).
# 32 octets en base64, à générer une fois avec : openssl rand -base64 32
# À garder chez l'hébergeur. La perdre ou la changer oblige chaque boutique à rouvrir l'application.
TOKEN_ENCRYPTION_KEY=

# Mode "embedded" : sections facultatives à ouvrir aux marchands, séparées par des virgules.
# Valeurs acceptées : assistant, competitors, pagespeed. Vide : toutes masquées (recommandé au lancement).
EMBEDDED_FEATURES=

# Mode "embedded" : plafond du réglage « jetons d'IA par jour » d'une boutique (200000 par défaut).
AI_TOKENS_PER_DAY_MAX=

# Sauvegardes de la base dans <DATA_DIR>/backups : intervalle en heures (0 = jamais) et nombre de copies gardées.
# Par défaut : 24 et 7 en mode "embedded", aucune sauvegarde en mode local.
DB_BACKUP_HOURS=
DB_BACKUP_KEEP=

# Autorise le serveur à modifier la boutique (titres, descriptions, textes alternatifs, traductions).
# Laisser vide : la boutique reste en lecture seule. Mettre 1 seulement pour appliquer des corrections.
SHOPIFY_WRITES_ENABLED=

# Autorise le mode d'automatisation « auto » : l'IA applique seule des corrections, dans les limites
# réglées dans l'interface. Laisser vide : l'IA propose, un humain valide. Exige aussi SHOPIFY_WRITES_ENABLED=1.
SHOPIFY_AUTO_APPLY=

# Google (Search Console et Google Analytics) : fichier JSON du compte de service (lecture seule).
# Par défaut : secrets/google-service-account.json à la racine du dépôt (dossier ignoré par git).
GOOGLE_APPLICATION_CREDENTIALS=
# Propriété à lire, ex. sc-domain:exemple.fr. Vide : déduite de l'adresse du site.
GSC_PROPERTY=

# DataForSEO (volumes de recherche, positions) : identifiants de l'API, pas ceux du site.
# Préparé : aucune fonctionnalité ne s'en sert encore.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Shopify CLI avec Theme Access : mot de passe généré par l'application « Theme Access » (commence par shptka_).
# Sert uniquement au script scripts/theme.sh, pour travailler sur une copie non publiée du thème.
SHOPIFY_CLI_THEME_TOKEN=

# Google Analytics 4 : identifiant numérique de la propriété (Administration > Détails de la propriété).
# Le compte de service doit être ajouté comme Lecteur de cette propriété.
GA4_PROPERTY_ID=

# PageSpeed Insights (vitesse des pages) : clé d'API Google, à restreindre à « PageSpeed Insights API ».
GOOGLE_PAGESPEED_API_KEY=
